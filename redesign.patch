+          </nav>
+        </div>
+
+        <div className="lp-rodape-base">
+          <span>© {ano} Sócio Digital. Todos os direitos reservados.</span>
+          <span>Versão 5.0</span>
+        </div>
+      </div>
+    </footer>
+  );
+}
