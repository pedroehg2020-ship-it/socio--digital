+          </div>
+
+          {COLUNAS.map((c) => (
+            <nav key={c.titulo} aria-label={c.titulo}>
+              <h3>{c.titulo}</h3>
+              <ul>
+                {c.itens.map((i) => (
+                  <li key={i.texto}>
