+"""
+Ponto único para qualquer parte do sistema (radar, chat tools, jobs de sync)
+obter um access_token válido da Conta Azul para uma empresa, renovando
+automaticamente quando necessário. Mantém o refresh_token sempre atualizado
+no Mongo (a Conta Azul pode rotacionar o refresh_token a cada renovação).
+"""
+from datetime import datetime, timedelta, timezone
+from typing import Optional
+
+from database import db
+from integrations import contaazul
+
+
+async def get_valid_access_token(company_id: str) -> Optional[str]:
+    """Retorna um access_token válido para a empresa, ou None se não conectada."""
+    doc = await db.integrations.find_one({"company_id": company_id, "provider": "contaazul"})
+    if not doc or doc.get("status") != "connected":
+        return None
+
+    expires_at = doc["expires_at"]
+    if expires_at.tzinfo is None:
+        expires_at = expires_at.replace(tzinfo=timezone.utc)
+
+    # renova com 2 min de folga antes de expirar
+    if expires_at > datetime.now(timezone.utc) + timedelta(minutes=2):
+        return doc["access_token"]
+
+    try:
+        token_response = await contaazul.refresh_access_token(doc["refresh_token"])
+    except Exception:
+        await db.integrations.update_one({"_id": doc["_id"]}, {"$set": {"status": "error"}})
+        return None
+
+    fields = contaazul.tokens_to_fields(token_response)
+    await db.integrations.update_one(
+        {"_id": doc["_id"]},
+        {"$set": {**fields, "status": "connected", "updated_at": datetime.now(timezone.utc)}},
+    )
+    return fields["access_token"]
