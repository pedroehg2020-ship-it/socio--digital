+"""
+Cliente OAuth2 para a API da Conta Azul (nova API, developers.contaazul.com).
+
+Fluxo:
+1. build_authorize_url()   -> URL para redirecionar o usuário (tela de login/consentimento)
+2. exchange_code_for_tokens(code) -> troca o "code" recebido no callback por access/refresh token
+3. refresh_access_token(refresh_token) -> renova o access_token quando expira
+4. authenticated_request(...) -> chamada autenticada à API, com refresh automático em caso de 401
+
+Credenciais da aplicação (obtidas em https://portaldevs.contaazul.com/ -> "Minhas Aplicações"):
+    CONTAAZUL_CLIENT_ID
+    CONTAAZUL_CLIENT_SECRET
+    CONTAAZUL_REDIRECT_URI   (deve ser cadastrada identicamente no portal de devs)
+"""
+import base64
+import os
+from datetime import datetime, timedelta, timezone
+from urllib.parse import urlencode
+
+import httpx
+
+AUTH_BASE_URL = "https://auth.contaazul.com"
+API_BASE_URL = "https://api-v2.contaazul.com"
+AUTHORIZE_PATH = "/login"
+TOKEN_PATH = "/oauth2/token"
+
+# Escopos necessários para o MVP: leitura de vendas e financeiro.
+# Ajustar conforme os recursos liberados para a aplicação no portal de devs.
+DEFAULT_SCOPES = "openid profile aws.cognito.signin.user.admin"
+
+
+class ContaAzulConfigError(RuntimeError):
+    """Credenciais da aplicação Conta Azul não configuradas no .env."""
+
+
+def _get_config():
+    client_id = os.environ.get("CONTAAZUL_CLIENT_ID")
+    client_secret = os.environ.get("CONTAAZUL_CLIENT_SECRET")
+    redirect_uri = os.environ.get("CONTAAZUL_REDIRECT_URI")
+    if not client_id or not client_secret or not redirect_uri:
+        raise ContaAzulConfigError(
+            "Integração Conta Azul não configurada. Defina CONTAAZUL_CLIENT_ID, "
+            "CONTAAZUL_CLIENT_SECRET e CONTAAZUL_REDIRECT_URI no .env do backend."
+        )
+    return client_id, client_secret, redirect_uri
+
+
+def is_configured() -> bool:
+    try:
+        _get_config()
+        return True
+    except ContaAzulConfigError:
+        return False
+
+
+def _basic_auth_header(client_id: str, client_secret: str) -> str:
+    raw = f"{client_id}:{client_secret}".encode()
+    return "Basic " + base64.b64encode(raw).decode()
+
+
+def build_authorize_url(state: str) -> str:
+    """Monta a URL para onde o usuário deve ser redirecionado para autorizar o app."""
+    client_id, _client_secret, redirect_uri = _get_config()
+    params = {
+        "response_type": "code",
+        "client_id": client_id,
+        "redirect_uri": redirect_uri,
+        "state": state,
+        "scope": DEFAULT_SCOPES,
+    }
+    return f"{AUTH_BASE_URL}{AUTHORIZE_PATH}?{urlencode(params)}"
+
+
+async def exchange_code_for_tokens(code: str) -> dict:
+    """Troca o authorization_code recebido no callback pelos tokens de acesso."""
+    client_id, client_secret, redirect_uri = _get_config()
+    headers = {
+        "Authorization": _basic_auth_header(client_id, client_secret),
+        "Content-Type": "application/x-www-form-urlencoded",
+    }
+    data = {
+        "grant_type": "authorization_code",
+        "code": code,
+        "redirect_uri": redirect_uri,
+    }
+    async with httpx.AsyncClient(timeout=30) as http:
+        resp = await http.post(f"{AUTH_BASE_URL}{TOKEN_PATH}", headers=headers, data=data)
+    resp.raise_for_status()
+    return resp.json()
+
+
+async def refresh_access_token(refresh_token: str) -> dict:
+    """Usa o refresh_token para obter um novo access_token."""
+    client_id, client_secret, _redirect_uri = _get_config()
+    headers = {
+        "Authorization": _basic_auth_header(client_id, client_secret),
+        "Content-Type": "application/x-www-form-urlencoded",
+    }
+    data = {
+        "grant_type": "refresh_token",
+        "refresh_token": refresh_token,
+    }
+    async with httpx.AsyncClient(timeout=30) as http:
+        resp = await http.post(f"{AUTH_BASE_URL}{TOKEN_PATH}", headers=headers, data=data)
+    resp.raise_for_status()
+    return resp.json()
+
+
+def tokens_to_fields(token_response: dict) -> dict:
+    """Converte a resposta do token endpoint nos campos persistidos em IntegrationDoc."""
+    expires_in = token_response.get("expires_in", 3600)
+    return {
+        "access_token": token_response["access_token"],
+        "refresh_token": token_response.get("refresh_token"),
+        "expires_at": datetime.now(timezone.utc) + timedelta(seconds=expires_in),
+    }
+
+
+async def authenticated_request(method: str, path: str, access_token: str, **kwargs) -> httpx.Response:
+    """Chamada autenticada a um endpoint de recurso da API (ex.: /v1/venda, /v1/financeiro/eventos-financeiros)."""
+    headers = kwargs.pop("headers", {})
+    headers["Authorization"] = f"Bearer {access_token}"
+    async with httpx.AsyncClient(timeout=30) as http:
+        return await http.request(method, f"{API_BASE_URL}{path}", headers=headers, **kwargs)
