new file mode 100644
index 0000000..e92dd8e
--- /dev/null
+++ b/backend/routes/integration_routes.py
@@ -0,0 +1,116 @@
+import logging
+import os
+import secrets
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, HTTPException, Query
+from fastapi.responses import RedirectResponse
+
+from database import db
+from models import UserDoc, IntegrationDoc
+from auth import get_current_user, require_role, JWT_SECRET
+import jwt as pyjwt
+from integrations import contaazul
+
+logger = logging.getLogger(__name__)
+router = APIRouter(prefix="/integrations", tags=["integrations"])
+
+FRONTEND_URL = os.environ.get("FRONTEND_URL", "http://localhost:3000")
+
+# state assinado (JWT curto) para o callback do OAuth carregar de volta o company_id/user_id
+# sem depender de sessão de cookie (a Conta Azul redireciona o navegador do usuário).
+STATE_ALGORITHM = "HS256"
+
+
+def _build_state(company_id: str, user_id: str) -> str:
+    payload = {
+        "company_id": company_id,
+        "user_id": user_id,
+        "nonce": secrets.token_hex(8),
+    }
+    return pyjwt.encode(payload, JWT_SECRET, algorithm=STATE_ALGORITHM)
+
+
+def _parse_state(state: str) -> dict:
+    try:
+        return pyjwt.decode(state, JWT_SECRET, algorithms=[STATE_ALGORITHM])
+    except pyjwt.PyJWTError:
+        raise HTTPException(status_code=400, detail="Parâmetro state inválido ou expirado")
+
+
+@router.get("/contaazul/status")
+async def contaazul_status(current_user: UserDoc = Depends(get_current_user)):
+    if not contaazul.is_configured():
+        return {"configured": False, "connected": False}
+    doc = await db.integrations.find_one({"company_id": current_user.company_id, "provider": "contaazul"})
+    if not doc or doc.get("status") != "connected":
+        return {"configured": True, "connected": False}
+    integration = IntegrationDoc.from_mongo(doc)
+    return {
+        "configured": True,
+        "connected": True,
+        "last_sync_at": integration.last_sync_at,
+        "connected_at": integration.created_at,
+    }
+
+
+@router.get("/contaazul/connect")
+async def contaazul_connect(current_user: UserDoc = Depends(require_role("owner", "manager"))):
+    """Retorna a URL de autorização para o frontend redirecionar o usuário."""
+    if not contaazul.is_configured():
+        raise HTTPException(
+            status_code=400,
+            detail="Integração Conta Azul ainda não configurada (credenciais da aplicação ausentes).",
+        )
+    state = _build_state(current_user.company_id, current_user.id)
+    return {"authorize_url": contaazul.build_authorize_url(state)}
+
+
+@router.get("/contaazul/callback")
+async def contaazul_callback(code: str = Query(None), state: str = Query(None), error: str = Query(None)):
+    """Endpoint de redirecionamento cadastrado no portal de devs da Conta Azul."""
+    if error:
+        return RedirectResponse(f"{FRONTEND_URL}/configuracoes?contaazul=error")
+    if not code or not state:
+        return RedirectResponse(f"{FRONTEND_URL}/configuracoes?contaazul=error")
+
+    claims = _parse_state(state)
+    company_id = claims["company_id"]
+    user_id = claims["user_id"]
+
+    try:
+        token_response = await contaazul.exchange_code_for_tokens(code)
+    except Exception as e:
+        logger.error(f"Falha ao trocar code por token (Conta Azul, company {company_id}): {e}")
+        return RedirectResponse(f"{FRONTEND_URL}/configuracoes?contaazul=error")
+
+    fields = contaazul.tokens_to_fields(token_response)
+    now = datetime.now(timezone.utc)
+    existing = await db.integrations.find_one({"company_id": company_id, "provider": "contaazul"})
+    if existing:
+        await db.integrations.update_one(
+            {"_id": existing["_id"]},
+            {"$set": {**fields, "status": "connected", "connected_by": user_id, "updated_at": now}},
+        )
+    else:
+        integration = IntegrationDoc(
+            company_id=company_id,
+            provider="contaazul",
+            connected_by=user_id,
+            status="connected",
+            **fields,
+        )
+        await db.integrations.insert_one(integration.to_mongo())
+
+    return RedirectResponse(f"{FRONTEND_URL}/configuracoes?contaazul=connected")
+
+
+@router.post("/contaazul/disconnect")
+async def contaazul_disconnect(current_user: UserDoc = Depends(require_role("owner", "manager"))):
+    result = await db.integrations.update_one(
+        {"company_id": current_user.company_id, "provider": "contaazul"},
+        {"$set": {"status": "disconnected", "updated_at": datetime.now(timezone.utc)}},
+    )
+    if result.matched_count == 0:
+        raise HTTPException(status_code=404, detail="Nenhuma conexão com a Conta Azul encontrada")
+    return {"success": True}
